# Copy to .env and fill in only what you want to change — every value below
# has a working, zero-dependency default (see cortex/config.py).

# --- LLM backend: "mock" (default, offline, deterministic) | "groq" ---
LLM_BACKEND=mock
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Search backend: "offline" (default, deterministic fixture) | "live" ---
SEARCH_BACKEND=offline

# --- Graph memory backend: "memory" (default, local JSON) | "neo4j" ---
GRAPH_BACKEND=memory
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cortex-dev-password
GRAPH_SNAPSHOT_PATH=./data/graph_memory.json

# --- Vector memory: embedding backend "hash" (default, offline) | "st" ---
EMBEDDING_BACKEND=hash
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=cortex_chunks

# --- Agent pipeline tuning ---
MAX_REVISE_LOOPS=2
RESEARCHER_FANOUT=3

# --- API ---
CORS_ALLOW_ALL=true
